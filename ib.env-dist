# Copy to ib.env, loaded by env_file: in compose. Values are literal: no quotes, no $ expansion
# Adapted from ibcontroller's ibcontroller.env (v0.2.0, ad4eadd). Re-sync on ibcontroller releases
###############################################################################
#########   Credentials, see credentials section for more details
#########   https://github.com/gnzsnz/ib-gateway-docker?tab=readme-ov-file#credentials
#########
#########   To start update IBC_USERID and IBC_PASSWORD, everything is ready
#########   to start in paper mode with default VNC password, see VNC_SERVER_PASSWORD
###############################################################################
IBC_USERID=myTwsAccountName
IBC_PASSWORD=myTwsPassword
# for credentials
# IBC_PASSWORD_FILE=
# for parallel execution, live and paper simultaneourly (image-level only, no
# ibcontroller-side pair -- see IBC_TRADING_MODE=both below)
# IBC_USERID_PAPER=
# IBC_PASSWORD_PAPER=
# IBC_PASSWORD_PAPER_FILE=
# Docker-secrets pattern: point at a file instead, wins over the plain var if set
# IBC_USERID_FILE=

###############################################################################
#########   ibcontroller settings
#########   for reference please visit
#########   https://github.com/gnzsnz/ibcontroller/blob/main/README.md
###############################################################################

# defaults to "{program}-{trading_mode}" (e.g. "gateway-paper")
# IBC_INSTANCE=
# "live", "paper" or "both" (image-only: live and paper in parallel), default paper
IBC_TRADING_MODE=paper
# IBC: ReadOnlyLogin. TWS only, clicks "Enter Read Only" on the 2FA frame. true/false, default false
# IBC_READ_ONLY_LOGIN=false
# "manual"/"primary"/"primaryoverride"/"secondary", default manual
IBC_EXISTING_SESSION_ACTION=primary
# JVM heap for TWS/Gateway at launch, ie "1024m"/"4g". Default unset (leave the
# installed .vmoptions file's -Xmx value untouched)
# https://www.ibkrguides.com/traderworkstation/increase-tws-memory-size.htm
# IBC_JAVA_HEAP_SIZE=1024m
# jts.ini TimeZone, IANA name ie "Europe/Zurich". Default auto-detected (TZ env
# var, then /etc/localtime) -- set only to override the host/container's own
# IBC_TIME_ZONE=

###############################################################################
#########   Login/MFA timeout and retry settings
###############################################################################

# IBC: LoginDialogDisplayTimeout, seconds. Default 60
# IBC_LOGIN_DIALOG_DISPLAY_TIMEOUT=60
# IBC: SecondFactorAuthenticationTimeout, seconds. Default 180. IB's own limit for an
# unanswered 2FA push: a 2FA dialog closing at or after it counts as timed out
# IBC_MFA_TIMEOUT=180
# IBC: ReloginAfterSecondFactorAuthenticationTimeout. true/false, default false. true: log
# in again 5 s after a timed-out push, and enforce MFA_EXIT_INTERVAL after an approved one
IBC_RELOGIN_AFTER_MFA_TIMEOUT=yes
# IBC: SecondFactorAuthenticationExitInterval, seconds. Default 60. With relogin on: wait
# for login to complete after the push is approved, then IBC_MFA_TIMEOUT_ACTION applies
# IBC_MFA_EXIT_INTERVAL=60
# IBC: --on2fatimeout. exit (code 75) or restart, default exit
IBC_MFA_TIMEOUT_ACTION=restart
# Max consecutive relaunches that never reach READY, then exit code 70. Default 3
# IBC_RESTART_CAP=3

###############################################################################
#########   Self-scheduled shutdown actions (ibcontroller-side, not GUI settings)
###############################################################################

# ColdRestartTime "HH:MM" 24-hour local time, every Sunday: close tidily and
# relaunch with a full fresh login (weekly reauth). Default unset (disabled)
# IBC_COLD_RESTART_TIME=13:00
# ClosedownAt "HH:MM" (daily) or "<Weekday> HH:MM" (weekly): close tidily, no
# relaunch. If both COLD_RESTART_TIME and CLOSEDOWN_AT are set, whichever occurs
# first wins. Default unset (disabled)
IBC_CLOSEDOWN_AT=

###############################################################################
#########   Logging and diagnostics
#########   https://github.com/gnzsnz/ibcontroller/blob/main/README.md#logging
###############################################################################

# IBC_LOG_SINK is fixed to "std" in the image (Dockerfile.template), so the
# ibcontroller log stays on the console (docker logs). Do not set it here.
# Raw wire trace (cmd-/events-{instance}.jsonl under log dir, always file, verbose).
# true/false, independent of IBC_LOG_LEVEL. Default false
# IBC_TRACE_ENABLED=
# Default, platform log dir (see app_dirs.py)
# IBC_LOG_DIR=
# Verbosity of ibcontroller and Java agent logs: debug/info/warning/error, any letter
# case. Default info. Independent of IBC_TRACE_ENABLED
# IBC_LOG_LEVEL=
# Rotation is ON BY DEFAULT (10 MiB x 5 backups) -- leaving these unset does NOT
# disable it, it just uses that default. Set IBC_LOG_MAX_BYTES=0 to disable.
# Only respected when IBC_LOG_SINK=file.
# Rotate log/trace files at this size in bytes. Default 10485760 (10 MiB)
# IBC_LOG_MAX_BYTES=
# Number of rotated backups to keep. Default 5
# IBC_LOG_BACKUP_COUNT=
# "known"/"unknown"/"all", default "known"
# IBC_DIAGNOSTIC_SCOPE=
# "open"/"openclose"/"never", default "never"
# IBC_DIAGNOSTIC_WHEN=
# Log a dump of each Global Configuration tree node in labels settings.sweep_paths,
# true/false, default false
# IBC_DIAGNOSTIC_SETTINGS_SWEEP=

###############################################################################
#########   IBKR settings and pop-ups (the [ibkr] table of ibcontroller.toml;
#########   these variables win over it)
###############################################################################

# A "_FILE" suffix reads the value from a file. An empty value counts as unset, and a
# setting with no value is left as it is in Gateway/TWS. Values are checked at startup.
# Every variable starting with IBKR_ is read as an [ibkr] key. One that names no setting or
# dialog is logged as a warning and ignored: treat the prefix as reserved for ibcontroller.

# Settings, written once at startup. true/false/yes/no in any case for a toggle.
# Auto logoff time, "hh:mm AM/PM" ie "08:00 AM". If both times are set, restart wins.
# IBKR_AUTO_LOGOFF_TIME=
# Auto restart time, "hh:mm AM/PM" ie "08:00 AM"
IBKR_AUTO_RESTART_TIME=11:59 PM
# API read-only mode. true/false, default unset
IBKR_READ_ONLY_API=no
# API socket port, number. IBKR defaults: 7496 TWS live, 7497 TWS paper, 4001 Gateway
# live, 4002 Gateway paper. On TWS a confirmation dialog follows, see
# IBKR_SOCKET_PORT_CONFIRMATION
# do not set in this image: socat and the ssh tunnel forward to fixed ports (see README)
# IBKR_SOCKET_PORT=
# API master client ID, number
# IBKR_MASTER_API_CLIENT_ID=
# Send market data in lots for US stocks. true/false. Do not set true yet: it opens a
# confirmation window that is not handled and blocks the settings step
# IBKR_SEND_MARKET_DATA_IN_LOTS_US_STOCKS=
# API precautions, true bypasses the warning for API orders, false keeps it
# IBKR_API_PRECAUTIONS_BYPASS_ORDER_PRECAUTIONS=
# IBKR_API_PRECAUTIONS_BYPASS_BOND_WARNING=
# IBKR_API_PRECAUTIONS_BYPASS_NEGATIVE_YIELD_TO_WORST=
# IBKR_API_PRECAUTIONS_BYPASS_CALLED_BOND_WARNING=
# IBKR_API_PRECAUTIONS_BYPASS_SAME_ACTION_PAIR_TRADE=
# IBKR_API_PRECAUTIONS_BYPASS_PRICE_BASED_VOLATILITY=
# IBKR_API_PRECAUTIONS_BYPASS_REDIRECT_ORDER_WARNING=
# IBKR_API_PRECAUTIONS_BYPASS_NO_OVERFILL_PROTECTION=
# Do not set the next one to true yet, it opens a confirmation window that is not handled
# IBKR_API_PRECAUTIONS_BYPASS_ROUTE_MARKETABLE_TO_BBO=

# Pop-ups. A dialog takes the name of one of its modes, or true/false/yes/no in any case
# (true/yes mean mode "on", false/no mean "off").

# "This is not a brokerage account" warning: clicks "I understand and accept"
# off/on, default on
# IBKR_NON_BROKERAGE_ACCOUNT=
# Confirmation shown after Gateway/TWS is set to restart automatically: clicks "OK".
# off/on, default on
# IBKR_AUTO_RESTART_CONFIRMATION=
# Password expiry notice: clicks "OK".
# off/on, default off
# IBKR_PASSWORD_EXPIRY_WARNING=
# Blind trading warning for a product without market data: clicks "Override and
# Transmit" or "Yes".
# off/on, default off
# IBKR_BLIND_TRADING=
# TWS only: asks whether the new socket port applies at once, shown after the port is
# changed. on clicks "Yes", no clicks "No", off leaves it to you
# off/on/no, default off
# IBKR_SOCKET_PORT_CONFIRMATION=
# "Accept incoming connection" dialog, shown when an API client connects: accept clicks
# "OK" or "Yes", reject clicks "No", manual leaves it to you.
# manual/accept/reject, default manual
# IBKR_ACCEPT_INCOMING_CONNECTIONS=
# Cryptocurrency order confirmation: transmit clicks "Transmit" and places the order with
# no check by you, cancel clicks "Cancel", manual leaves it to you.
# manual/transmit/cancel, default manual
# IBKR_CRYPTO_ORDER_CONFIRMATION=
