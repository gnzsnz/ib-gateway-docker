###############################################################################
#########   Credentials, see credentials section for more details
#########   https://github.com/gnzsnz/ib-gateway-docker?tab=readme-ov-file#credentials
#########
#########   To start update IBC_USERID and IBC_PASSWORD, everything is ready
#########   to start in paper mode with default VNC password, see VNC_SERVER_PASSWORD
###############################################################################
IBC_USERID=myTwsAccountName
IBC_PASSWORD=myTwsPassword
# for credentials
# IBC_PASSWORD_FILE=
# for parallel execution, live and paper simultaneourly (image-level only, no
# ibcontroller-side pair -- see IBC_TRADING_MODE=both below)
# IBC_USERID_PAPER=
# IBC_PASSWORD_PAPER=
# IBC_PASSWORD_PAPER_FILE=
# TWS rdesktop password
# RDP_PASSWORD=abc
# RDP_PASSWORD_FILE=
# TWS rdesktop UID and GID
# PUID=1000
# PGID=1000
# other options, Etc/UTC, Europe/Paris, America/New_York, Asia/Tokyo
TIME_ZONE=Europe/Zurich
###############################################################################
#########   Settings path and custom config, see documentation
#########   https://github.com/gnzsnz/ib-gateway-docker?tab=readme-ov-file#preserve-settings-across-containers
###############################################################################
# ib-gateway
# IBC_TWS_SETTINGS_PATH=/home/ibgateway/tws_settings
# tws
# IBC_TWS_SETTINGS_PATH=/config/tws_settings
# commented, not "=" empty: ibcontroller treats present-but-empty the same as
# any other value, not as unset -- see the auto_logoff_time note below for why
# IBC_TWS_SETTINGS_PATH=/home/ibgateway/tws_settings
# if you need custom config
# https://github.com/gnzsnz/ib-gateway-docker?tab=readme-ov-file#customizing-the-image
# CUSTOM_CONFIG=
# ibcontroller.toml/ibkr_settings.toml/labels.json volume -- mount the whole
# IBC_APP_DIR (default /home/ibgateway/ibcontroller, see the Dockerfile), not
# just its config subdir; ibcontroller scaffolds starter files into it on
# first run. Host dir must exist and be owned by USER_ID:USER_GID beforehand.
# IBC_APP_DIR/run (agent sockets) must stay tmpfs, not part of this bind
# mount -- see docker-compose.yml's volumes/tmpfs for both.
###############################################################################
#########   Java memory settings, see
#########   https://www.ibkrguides.com/traderworkstation/increase-tws-memory-size.htm
###############################################################################
# includes the unit now, e.g. "1024m"/"4g" -- applied by ibcontroller itself
# at launch, no image-side vmoptions sed anymore
# IBC_JAVA_HEAP_SIZE=1024m
###############################################################################
#########   ibcontroller settings
#########   these are ibcontroller settings, read directly from the environment
#########   for reference please visit
#########   https://github.com/gnzsnz/ibcontroller/blob/main/README.md
###############################################################################
# trading mode can be live,paper,both - both allows for parallel live and paper
IBC_TRADING_MODE=paper
IBC_READ_ONLY_API=no
IBC_MFA_TIMEOUT_ACTION=restart
# commented, not "=" empty: ibcontroller treats present-but-empty ("") the
# same as any other value, not as unset -- this field's own default (60) is
# a plain float, so "" fails its converter outright (ConfigError), rather
# than falling back to that default the way a genuinely absent var would
# IBC_MFA_EXIT_INTERVAL=60
IBC_AUTO_RESTART_TIME=11:59 PM
# commented, not "=" empty: ibcontroller's hh:mm AM/PM validator rejects "",
# unlike a genuinely unset var (which means "leave unchanged")
# IBC_AUTO_LOGOFF_TIME=08:00 PM
# "HH:MM", weekly on Sunday -- direct rename of TWS_COLD_RESTART, same format;
# commented for the same "" != unset reason as auto_logoff_time above
# IBC_COLD_RESTART_TIME=13:00
# commented, not "=" empty: this field's own default (manual) is a plain
# enum, so "" is an invalid value outright (ConfigError), rather than
# falling back to that default the way a genuinely absent var would
# IBC_ACCEPT_INCOMING_CONNECTIONS=manual
IBC_RELOGIN_AFTER_MFA_TIMEOUT=yes
IBC_EXISTING_SESSION_ACTION=primary
# no ibcontroller setting yet for: TWOFA_DEVICE, ALLOW_BLIND_TRADING,
# TWS_MASTER_CLIENT_ID, SAVE_TWS_SETTINGS, BYPASS_WARNING -- the last four
# become ibkr_settings.toml entries on the mounted config volume instead of
# an env var; BYPASS_WARNING's old behavior is ibcontroller's default
###############################################################################
#########   VNC settings
###############################################################################
VNC_SERVER_PASSWORD=myVncPassword
# see credentials section for more details
# VNC_SERVER_PASSWORD_FILE
###############################################################################
#########   SSH tunnel settings, see documentation
#########   https://github.com/gnzsnz/ib-gateway-docker?tab=readme-ov-file#ssh-tunnel
###############################################################################
SSH_TUNNEL=
SSH_OPTIONS=
SSH_ALIVE_INTERVAL=
SSH_ALIVE_COUNT=
SSH_PASSPHRASE=
SSH_PASSPHRASE_FILE=
SSH_REMOTE_PORT=
SSH_USER_TUNNEL=
SSH_RESTART=
SSH_VNC_PORT=
SSH_RDP_PORT=
###############################################################################
#########   Start scripts settings, see documentation
#########   https://github.com/gnzsnz/ib-gateway-docker?tab=readme-ov-file#start-up-scripts
###############################################################################
#START_SCRIPTS=init-scripts/start_scripts
#X_SCRIPTS=init-scripts/x_scripts
#IBC_SCRIPTS=init-scripts/ibc_scripts
###############################################################################
#########   Docker build arguments
#########   Use them to build non pypi releases
###############################################################################
# IBCONTROLLER_SOURCE=git
# IBCONTROLLER_GIT_REPO=https://github.com/gnzsnz/ibcontroller
# IBCONTROLLER_GIT_REF=feat/my_feat
###############################################################################
